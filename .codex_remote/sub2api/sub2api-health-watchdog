#!/usr/bin/env bash
set -u

DOCKER=/usr/bin/docker
LOGGER=/usr/bin/logger
PRIORITY_BOOST=/usr/local/sbin/sub2api-priority-boost

check_container() {
  local container=$1
  local status

  status=$("$DOCKER" inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck{{end}}' "$container" 2>/dev/null || echo missing)

  case "$status" in
    healthy|starting|no-healthcheck)
      return 0
      ;;
    unhealthy)
      "$LOGGER" -t sub2api-health-watchdog "$container is unhealthy; restarting"
      "$DOCKER" restart "$container" >/dev/null 2>&1 || return 0
      if [ -x "$PRIORITY_BOOST" ]; then
        "$PRIORITY_BOOST" >/dev/null 2>&1 || true
      fi
      ;;
    missing|*)
      "$LOGGER" -t sub2api-health-watchdog "$container status=$status"
      ;;
  esac
}

check_container sub2api-postgres
check_container sub2api-redis
check_container sub2api
