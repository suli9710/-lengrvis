#!/usr/bin/env bash
set -u

DOCKER=/usr/bin/docker
RENICE=/usr/bin/renice
IONICE=

if command -v ionice >/dev/null 2>&1; then
  IONICE=$(command -v ionice)
fi

boost_container() {
  local container=$1
  local nice_level=$2
  local ionice_class=${3:-2}
  local ionice_level=${4:-0}
  local pids

  if ! "$DOCKER" inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -qx true; then
    return 0
  fi

  pids=$("$DOCKER" top "$container" -eo pid= 2>/dev/null | awk '/^[[:space:]]*[0-9]+[[:space:]]*$/ {print $1}')
  if [ -z "$pids" ]; then
    return 0
  fi

  # Raise normal scheduler priority; avoid realtime scheduling.
  "$RENICE" -n "$nice_level" -p $pids >/dev/null 2>&1 || true

  if [ -n "$IONICE" ]; then
    for pid in $pids; do
      "$IONICE" -c "$ionice_class" -n "$ionice_level" -p "$pid" >/dev/null 2>&1 || true
    done
  fi
}

boost_container sub2api -10 2 0
boost_container sub2api-postgres -5 2 0
boost_container sub2api-redis -5 2 0
