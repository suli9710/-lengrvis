{
  "name": "lengrvis-mobile",
  "version": "0.1.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-eas-cli-runtime.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "preflight:android-release": "npm run smoke:eas-cli-compat && powershell -ExecutionPolicy Bypass -File ../scripts/verify_android_release_gate.ps1 -PreflightOnly",
    "build:android:preview": "npm run preflight:android-release && eas build --platform android --profile preview --non-interactive",
    "build:android:production": "npm run preflight:android-release && eas build --platform android --profile production --non-interactive",
    "gate:android-release": "powershell -ExecutionPolicy Bypass -File ../scripts/verify_android_release_gate.ps1",
    "typecheck": "tsc --noEmit",
    "smoke:token": "node scripts/mobile-token-smoke.cjs",
    "smoke:consent": "node scripts/consent-smoke.cjs",
    "smoke:session-lifecycle": "node scripts/session-lifecycle-smoke.cjs",
    "smoke:push-notifications": "node scripts/push-notification-smoke.cjs",
    "smoke:push-subscription-lifecycle": "node scripts/push-subscription-lifecycle-smoke.cjs",
    "smoke:approval-status-label": "node scripts/approval-status-label-smoke.cjs",
    "smoke:task-companion": "node scripts/mobile-task-companion-smoke.cjs",
    "smoke:remote-input-grant": "node scripts/remote-input-grant-smoke.cjs",
    "smoke:wakeup-contract": "node scripts/wakeup-contract-smoke.cjs",
    "smoke:android-back": "node scripts/android-back-navigation-smoke.cjs",
    "smoke:android-hardening-plugin": "node scripts/android-hardening-plugin-smoke.cjs",
    "smoke:android-prebuild-network-security": "node scripts/android-prebuild-network-security-smoke.cjs",
    "smoke:android-manifest-resources": "node scripts/android-manifest-resources-smoke.cjs",
    "smoke:android-lan-tls": "node scripts/android-lan-tls-smoke.cjs",
    "smoke:eas-cli-compat": "node scripts/eas-cli-compat-smoke.cjs",
    "gate:android-instrumentation-compile": "node scripts/android-lan-tls-smoke.cjs --compile-instrumentation",
    "gate:android-connected-lan-tls": "node scripts/android-lan-tls-smoke.cjs --connected"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "58.0.17",
    "expo-camera": "58.0.12",
    "expo-constants": "58.0.13",
    "expo-device": "58.0.5",
    "expo-linking": "58.0.14",
    "expo-notifications": "58.1.6",
    "expo-router": "58.0.25",
    "expo-secure-store": "58.0.2",
    "lucide-react-native": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eas-cli": "25.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ajv": "8.18.0",
    "diff": "8.0.3",
    "eas-cli@22.2.0": {
      "minimatch@5.1.2": "5.1.9",
      "ts-deepmerge@6.2.0": "8.0.0"
    },
    "joi": "17.13.8",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "nanoid": "3.3.18",
    "node-forge": "1.4.0",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "yaml": "2.8.3"
  }
}
