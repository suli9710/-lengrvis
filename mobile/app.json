{
  "expo": {
    "name": "Lengrvis 手机端",
    "slug": "lengrvis-approval",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "lengrvisapproval",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.lengrvis.approval",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "允许 Lengrvis 手机端使用相机扫描电脑端配对二维码。"
      }
    },
    "plugins": [
      "./plugins/withAndroidRemoteControlHardening",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 Lengrvis 手机端使用相机扫描电脑端配对二维码。",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
