{
  "expo": {
    "name": "Lengrvis Approval",
    "slug": "lengrvis-approval",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lengrvisapproval",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.lengrvis.approval",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
