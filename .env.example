# Lengrvis — configuration template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE
#   1. Copy this file to `.env`  (cp .env.example .env)
#   2. Fill in your real values
#   3. NEVER commit your .env to source control
#      • .env is already listed in .gitignore
#      • If you accidentally committed it, run:
#          git rm --cached .env
#          git commit -m "chore: stop tracking .env"
#        and rotate any secrets that were exposed.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
LENGRVIS_PROVIDER_NAME=openai_compatible

# API endpoint — release cloud service by default; can be replaced with any OpenAI-compatible proxy
LENGRVIS_BASE_URL=https://lengzhehao.com/v1

# API key — choose ONE method:
#   Option A (plain text — dev/CI only, not recommended for production):
# LENGRVIS_API_KEY=sk-...
LENGRVIS_API_KEY=
#   Option B (Windows DPAPI encrypted blob — recommended for personal machines):
#   Run `scripts/encrypt_api_key.ps1` to generate the encrypted value.
# LENGRVIS_API_KEY_ENCRYPTED=dpapi:...
LENGRVIS_API_KEY_ENCRYPTED=

# Model names (use standard OpenAI model IDs, e.g. gpt-4o, gpt-4o-mini)
LENGRVIS_MODEL=gpt-4o
LENGRVIS_REVIEW_MODEL=

# Wire API: "chat_completions" (standard) | "responses" (OpenAI Responses API)
LENGRVIS_WIRE_API=chat_completions
LENGRVIS_REQUIRES_OPENAI_AUTH=true

# Reasoning effort hint (medium | high | xhigh) — only used by reasoning models
LENGRVIS_MODEL_REASONING_EFFORT=medium

# ── Context & Token Limits ───────────────────────────────────────────────────
LENGRVIS_MODEL_CONTEXT_WINDOW=128000
LENGRVIS_MODEL_AUTO_COMPACT_TOKEN_LIMIT=96000
LENGRVIS_MAX_TOKENS=1600
LENGRVIS_TIMEOUT=30
LENGRVIS_CONTEXT_WARNING_BUFFER_TOKENS=20000
LENGRVIS_CONTEXT_ERROR_BUFFER_TOKENS=20000
LENGRVIS_CONTEXT_MANUAL_COMPACT_BUFFER_TOKENS=3000
LENGRVIS_CONTEXT_RECENT_MESSAGE_LIMIT=24

# ── Privacy & Data Controls (all off by default) ─────────────────────────────
# Whether Agent context (task history, summaries) may be sent to the LLM cloud
LENGRVIS_ALLOW_CLOUD_CONTEXT=false
# Whether file contents may be uploaded to the LLM cloud
LENGRVIS_ALLOW_FILE_CONTENT_UPLOAD=false
# Whether the browser tool may make real network requests
LENGRVIS_ALLOW_BROWSER_NETWORK=false
# Overall network access for the Agent: "disabled" | "enabled"
LENGRVIS_NETWORK_ACCESS=disabled
# Disable storage of LLM responses server-side (for providers that support it)
LENGRVIS_DISABLE_RESPONSE_STORAGE=false

# ── File Access ───────────────────────────────────────────────────────────────
# Semicolon-separated list of absolute directories the Agent may read/write.
# Leave empty to disable all file system access.
# Example: LENGRVIS_ALLOWED_DIRECTORIES=C:\Users\You\Documents;C:\Projects
LENGRVIS_ALLOWED_DIRECTORIES=

# ── Embedding & Local Models ─────────────────────────────────────────────────
LENGRVIS_EMBEDDING_MODEL=text-embedding-3-small
# LENGRVIS_ONNX_ENABLED=true

# ── Backend Process (set by desktop launcher — edit only for standalone use) ──
LENGRVIS_BACKEND_URL=http://127.0.0.1:8000
LENGRVIS_BACKEND_COMMAND=python
LENGRVIS_BACKEND_ARGS=-m uvicorn backend.main:full_app --host 127.0.0.1 --port 8000
LENGRVIS_FULL_BACKEND=1

# ── Retry & Resilience ───────────────────────────────────────────────────────
LENGRVIS_RECOVERY_MAX_RETRIES=3
LENGRVIS_LLM_API_MAX_RETRIES=3
LENGRVIS_LLM_API_RETRY_BACKOFF_SECONDS=1.0
LENGRVIS_ALLOW_MOCK_FALLBACK=false

# ── Local Secrets ────────────────────────────────────────────────────────────
# Leave blank to persist a generated mobile JWT secret under LENGRVIS_DATA_DIR.
LENGRVIS_JWT_SECRET=

# ── Commercial Release Gate ─────────────────────────────────────────────────
LENGRVIS_COMMERCIAL_RELEASE=false

# ── Mode ─────────────────────────────────────────────────────────────────────
# efficiency | quality
LENGRVIS_MODE=efficiency
