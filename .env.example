LENGRVIS_PROVIDER_NAME=openai_compatible
LENGRVIS_BASE_URL=https://api.openai.com/v1
# 留空时 efficiency / hybrid 可按 LENGRVIS_ALLOW_MOCK_FALLBACK 使用 MockProvider 做开发演示。
# privacy 模式不会使用 MockProvider 兜底，必须检测到 Ollama / LM Studio / llama.cpp-compatible server。
LENGRVIS_API_KEY=
LENGRVIS_MODEL=gpt-4o-mini
LENGRVIS_MODEL_CONTEXT_WINDOW=128000
LENGRVIS_MODEL_AUTO_COMPACT_TOKEN_LIMIT=96000
LENGRVIS_ONNX_MODEL_PATH=
LENGRVIS_ONNX_EXECUTION_PROVIDER=
LENGRVIS_EMBEDDING_MODEL=text-embedding-3-small
LENGRVIS_CONTEXT_AUTO_COMPACT_ENABLED=true
LENGRVIS_CONTEXT_MICRO_COMPACT_ENABLED=true
LENGRVIS_CONTEXT_HISTORY_SNIP_ENABLED=true
LENGRVIS_CONTEXT_SESSION_MEMORY_ENABLED=true
LENGRVIS_CONTEXT_WARNING_BUFFER_TOKENS=20000
LENGRVIS_CONTEXT_ERROR_BUFFER_TOKENS=20000
LENGRVIS_CONTEXT_MANUAL_COMPACT_BUFFER_TOKENS=3000
LENGRVIS_CONTEXT_RECENT_MESSAGE_LIMIT=24
LENGRVIS_CONTEXT_MICRO_COMPACT_AGE=8
LENGRVIS_CONTEXT_MICRO_COMPACT_TOOL_RESULT_CHARS=1200
LENGRVIS_CONTEXT_HISTORY_SNIP_THRESHOLD=160
LENGRVIS_CONTEXT_HISTORY_SNIP_KEEP_RECENT=80
LENGRVIS_CONTEXT_SESSION_SUMMARY_LIMIT=12000
LENGRVIS_LLM_API_MAX_RETRIES=2
LENGRVIS_LLM_API_RETRY_BACKOFF_SECONDS=0.25
LENGRVIS_LLM_API_CIRCUIT_FAILURE_THRESHOLD=5
LENGRVIS_LLM_API_CIRCUIT_COOLDOWN_SECONDS=30.0
# privacy = 本地 LLM 后端可用时运行；efficiency = 云端 provider；hybrid = 规划可上云、执行优先本地。
LENGRVIS_MODE=efficiency
# 商业化套餐 (Free / Pro / Team-Self-hosted)，驱动后端 feature gating。
# free = 本机只读 + 基础任务；pro = 云端额度 + 文档AI + 调度 + 手机远控；team = 审计导出 + 策略管控 + 私有部署。
# 高风险能力(手机远控)仅 pro/team 可用：free 即使设置 LENGRVIS_REMOTE_DESKTOP_ENABLED=true 也会被强制关闭，付费层仍需逐次强审批。
LENGRVIS_PLAN=free
LENGRVIS_ALLOW_CLOUD_CONTEXT=false
LENGRVIS_ALLOW_FILE_CONTENT_UPLOAD=false
LENGRVIS_ALLOW_BROWSER_NETWORK=false
LENGRVIS_STRICT_STATE_MACHINE=false
LENGRVIS_RECOVERY_MAX_RETRIES=3
LENGRVIS_EXECUTION_ENGINES=dual
LENGRVIS_DEFAULT_ENGINE=auto
LENGRVIS_AGENT_LOOP_MAX_TURNS=30
LENGRVIS_RUN_EVENT_RETENTION_DAYS=30
# Leave blank to persist a generated mobile JWT secret in LENGRVIS_DATA_DIR/mobile_jwt.secret.
LENGRVIS_JWT_SECRET=
# 控制非隐私路径缺少真实 provider 时是否允许 MockProvider 演示兜底。
# 注意：privacy 模式探测不到本地后端时始终直接报错，不受此开关影响。
LENGRVIS_ALLOW_MOCK_FALLBACK=true
LENGRVIS_APP_ALLOWLIST=notepad;calculator;calc
LENGRVIS_BROWSER_MAX_PAGE_BYTES=250000
LENGRVIS_DOCUMENT_MAX_CHARS_TO_LLM=30000
LENGRVIS_BROWSER_SCREENSHOT_DIR=
LENGRVIS_ALLOWED_DIRECTORIES=
LENGRVIS_SKILL_DIRECTORIES=

# LAN mobile pairing transport.
# Setting cert/key enables HTTPS/wss readiness; this does not install or trust
# a certificate on mobile devices.
LENGRVIS_LAN_TLS_ENABLED=false
LENGRVIS_LAN_TLS_CERT_FILE=
LENGRVIS_LAN_TLS_KEY_FILE=
LENGRVIS_LAN_PUBLIC_BASE_URL=

LENGRVIS_BACKEND_URL=http://127.0.0.1:8000
LENGRVIS_BACKEND_COMMAND=python
LENGRVIS_BACKEND_ARGS=-m uvicorn backend.main:full_app --host 127.0.0.1 --port 8000
