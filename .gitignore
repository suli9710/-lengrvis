# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Node
node_modules/
dist/
build/
.turbo/
mobile/.expo/
mobile/android/.kotlin/

# Keep the signed macOS release entitlement template in the repo while
# continuing to ignore generated build output.
!desktop/build/
desktop/build/*
!desktop/build/entitlements.mac.plist

# Ollama runtime/model artifacts are downloaded on demand and must not be committed.
vendor/ollama/
vendor/ollama-models/
vendor/ollama-bundle-manifest.json

# vendor/lengrvis-code now lives as an independent git repository (repo slimming).
# Clone/restore it locally when the Lengrvis Code integration is needed; convert
# to a submodule with scripts/migrate_vendor_to_submodule.ps1 once it has a remote.
vendor/lengrvis-code/

# Local configuration and runtime data
.env
config.yaml
workspace/
*.db
*.sqlite
*.sqlite3
logs/
output/
.tmp/
.tmp-diagnostics/
tmp-office-review/
desktop/tmp-office-review/
.codex_remote/
.claude/settings.local.json
.cursor/
.superpowers/
/puzzler_bards*.json
UsersSuliAppDataLocalTempLengrvis-Code-review
.codex-vite-*.pid
.codex-vite-*.err.log
.codex-vite-*.out.log
.codex-vite-job.id
# Canonical local runtime data directory is .lengrvis_data.
.lengrvis_data/
# Locally generated secrets and keys must never be committed, regardless of
# where a custom LENGRVIS_DATA_DIR places them.
*.secret
*.key
*.pem
# Tooling caches and coverage artifacts
.ruff_cache/
.mypy_cache/
coverage.xml
junit*.xml
# Backend test scratch/debug artifacts
backend/tests/_*.log
backend/tests/_debug*.py
# Accidental pip/glob and agent screenshot artifacts.
=4.0
tmp-agent-*.png

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# JVM / HotSpot crash + replay dumps (P2-23) - never commit these
hs_err_pid*
replay_pid*
*.dmp
*.hprof
# Signing keystores must never be committed
*.keystore
*.jks
# Generated signed installer assets consumed only by release workflows.
desktop/release/
