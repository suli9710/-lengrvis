{
  "name": "lengrvis",
  "private": true,
  "version": "0.1.0",
  "description": "Lengrvis workspace packaging and QA scripts",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "test": "powershell -ExecutionPolicy Bypass -File ./scripts/test.ps1",
    "deps:verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_dependency_locks.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "qa:gate": "powershell -ExecutionPolicy Bypass -File ./scripts/test.ps1 -- --maxfail=1 && npm --prefix desktop run smoke",
    "release:check": "npm run qa:gate && powershell -ExecutionPolicy Bypass -File ./scripts/build_all.ps1 -VerifyOnly",
    "release:smoke": "npm run release:check && powershell -ExecutionPolicy Bypass -File ./scripts/build_all.ps1 -VerifyOnly -RunExecutableSmoke -SmokeTimeoutSeconds 45",
    "release:gate": "npm run release:check"
  },
  "engines": {
    "node": ">=20"
  }
}
