{
  "name": "lengrvis",
  "private": true,
  "version": "0.1.2",
  "license": "BUSL-1.1",
  "description": "Lengrvis workspace packaging and QA scripts",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "test": "powershell -ExecutionPolicy Bypass -File ./scripts/test.ps1",
    "hygiene": "powershell -ExecutionPolicy Bypass -File ./scripts/check_repo_hygiene.ps1",
    "deps:verify": "npm run hygiene && powershell -ExecutionPolicy Bypass -File ./scripts/verify_dependency_locks.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "qa:gate": "powershell -ExecutionPolicy Bypass -File ./scripts/test.ps1 -- --maxfail=1 && npm --prefix desktop run smoke",
    "golden:gate": "powershell -ExecutionPolicy Bypass -File ./scripts/run_golden_tasks.ps1",
    "eval:real-llm": "python scripts/run_real_llm_eval.py",
    "mcp:conformance:initialize": "npx --yes @modelcontextprotocol/conformance@0.1.16 client --command \"python scripts/mcp_conformance_client.py\" --scenario initialize --spec-version 2025-11-25 --output-dir .tmp/qa-evidence/mcp-conformance/initialize",
    "mcp:conformance:tools": "npx --yes @modelcontextprotocol/conformance@0.1.16 client --command \"python scripts/mcp_conformance_client.py\" --scenario tools_call --spec-version 2025-11-25 --output-dir .tmp/qa-evidence/mcp-conformance/tools-call",
    "mcp:conformance:basic": "npm run mcp:conformance:initialize && npm run mcp:conformance:tools",
    "mcp:conformance:sse-retry": "npx --yes @modelcontextprotocol/conformance@0.1.16 client --command \"python scripts/mcp_conformance_client.py\" --scenario sse-retry --spec-version 2025-11-25 --output-dir .tmp/qa-evidence/mcp-conformance/sse-retry",
    "mcp:conformance": "npm run mcp:conformance:basic && npm run mcp:conformance:sse-retry",
    "audit:deps": "powershell -ExecutionPolicy Bypass -File ./scripts/run_dependency_audit.ps1",
    "security:secrets": "powershell -ExecutionPolicy Bypass -File ./scripts/secret_scan.ps1",
    "sbom:generate": "powershell -ExecutionPolicy Bypass -File ./scripts/generate_sbom.ps1",
    "supply-chain:verify": "npm run deps:verify && npm run sbom:generate",
    "security:extensions": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_extension_security_gate.ps1",
    "security:threat-model": "python scripts/check_agentic_threat_model.py",
    "maintainability:size": "python scripts/check_source_size.py --top 25",
    "maintainability:gate": "python scripts/check_source_size.py --top 25 --max-lines 900 --allow-over-max-lines scripts/portable_first_screen_smoke.ps1 --allow-over-max-lines backend/app/services/ollama_service.py --allow-over-max-lines backend/app/services/run_service.py --allow-over-max-lines backend/app/context/management.py --allow-over-max-lines backend/app/api/routes_activation_admin.py --allow-over-max-lines backend/app/orchestration/os_execution_engine.py --allow-over-max-lines backend/app/services/document_intelligence_service.py --allow-over-max-lines backend/app/tools/developer_tools.py --allow-over-max-lines backend/app/services/browser_activity_runtime.py --allow-over-max-lines backend/app/commerce/licensing.py --allow-over-max-lines backend/app/policy/policy_engine.py --allow-over-max-lines scripts/verify_android_release_gate.ps1 --allow-over-max-lines scripts/verify_packaging.ps1 --allow-over-max-lines backend/app/commerce/activation.py --allow-over-max-lines backend/app/orchestration/developer_engine.py --allow-over-max-lines backend/app/perception/ui_automation.py --allow-over-max-lines backend/app/tools/vision_tools.py --allow-over-max-lines backend/app/api/routes_remote.py --allow-over-max-lines backend/app/services/task_explain_service.py --allow-over-max-lines backend/app/integrations/lengrvis_code.py --allow-over-max-lines backend/app/tools/cluster_tools.py --allow-over-max-lines backend/app/llm/onnx_provider.py --allow-over-max-lines backend/app/tools/app_tools.py --allow-over-max-lines scripts/verify_mobile_lan_wss_preflight.ps1 --allow-over-max-lines backend/app/services/cleanup_planner_service.py --allow-over-max-lines backend/app/llm/openai_compatible.py --allow-over-max-lines desktop/scripts/ipc-security-smoke.cjs --allow-over-max-lines desktop/scripts/settings-local-model-experience-smoke.cjs --allow-over-max-lines desktop/scripts/browser-activity-smoke.cjs --allow-over-max-lines desktop/scripts/first-launch-smoke.cjs --allow-over-max-lines mobile/scripts/mobile-token-smoke.cjs --allow-over-max-lines mobile/scripts/remote-input-grant-smoke.cjs --max-p95-lines 800 --max-area-max-lines backend=1400 --max-area-max-lines desktop=900 --max-area-max-lines desktop_scripts=2000 --max-area-max-lines desktop_styles=700 --max-area-max-lines mobile=900 --max-area-max-lines mobile_scripts=1100 --max-area-max-lines android_native=900 --max-area-max-lines scripts=2400",
    "release:readiness": "python scripts/check_release_readiness_dashboard.py --dashboard docs/release/release-readiness-dashboard.md",
    "release:readiness:strict": "python scripts/check_release_readiness_dashboard.py --dashboard docs/release/release-readiness-dashboard.md --strict",
    "release:readiness:rc": "python scripts/check_release_readiness_dashboard.py --dashboard docs/release/release-readiness-dashboard.md --rc-release",
    "review:scorecard": "python scripts/check_full_review_scorecard.py",
    "market:readiness": "python scripts/check_market_readiness.py --dashboard docs/business/market-readiness.md",
    "market:readiness:strict": "python scripts/check_market_readiness.py --dashboard docs/business/market-readiness.md --strict",
    "market:readiness:paid": "python scripts/check_market_readiness.py --dashboard docs/business/market-readiness.md --paid-launch",
    "license:admin": "python scripts/license_admin.py",
    "activation:admin": "python scripts/activation_admin.py",
    "activation:serve": "python -m uvicorn backend.activation_main:app --host 127.0.0.1 --port 8010",
    "release:safety": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_release_safety.ps1",
    "release:owner-signoff-payload": "python scripts/release_owner_signature.py --emit-payload-only --output build/release-owner-signoff-payload.json",
    "sign:windows:preflight": "powershell -ExecutionPolicy Bypass -File ./scripts/windows_signing_preflight.ps1",
    "sign:backend:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/sign_windows_backend.ps1",
    "refresh:portable-bundle": "powershell -ExecutionPolicy Bypass -File ./scripts/refresh_portable_release_bundle.ps1",
    "sign:portable:launcher": "powershell -ExecutionPolicy Bypass -File ./scripts/sign_windows_portable_artifacts.ps1 -LauncherOnly",
    "sign:portable:sfx": "powershell -ExecutionPolicy Bypass -File ./scripts/sign_windows_portable_artifacts.ps1 -SelfExtractingOnly",
    "sign:portable:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/sign_windows_portable_artifacts.ps1",
    "sign:windows:release": "npm run sign:backend:windows && npm run sign:portable:launcher && npm run refresh:portable-bundle && npm run sign:portable:sfx",
    "release:quick": "npm run qa:gate && npm run release:safety && powershell -ExecutionPolicy Bypass -File ./scripts/build_all.ps1 -VerifyOnly",
    "release:check": "npm run delivery:rc",
    "release:paid-launch": "npm run delivery:paid-launch",
    "release:smoke": "npm run delivery:rc",
    "release:gate": "npm run delivery:rc",
    "evidence:release": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_release_evidence_packet.ps1",
    "evidence:release-packet": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_release_evidence_packet.ps1",
    "evidence:current-release": "powershell -ExecutionPolicy Bypass -File ./scripts/generate_current_release_evidence.ps1",
    "evidence:rc-handoff": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_rc_handoff_template.ps1",
    "evidence:rc-handoff-template": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_rc_handoff_template.ps1",
    "evidence:result-quality-review": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_result_quality_review_packet.ps1",
    "evidence:mobile-lan-wss": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_mobile_lan_wss_preflight.ps1",
    "android:release-gate": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_android_release_gate.ps1",
    "evidence:android-real-device-template": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_android_real_device_evidence_template.ps1",
    "evidence:local-model-template": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_local_model_clean_machine_evidence_template.ps1",
    "evidence:diagnostics-review": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_diagnostics_external_review_packet.ps1",
    "evidence:distribution-template": "powershell -ExecutionPolicy Bypass -File ./scripts/collect_distribution_release_evidence_template.ps1",
    "evidence:paid-launch-template": "python scripts/collect_paid_launch_evidence_templates.py",
    "evidence:distribution-verify": "python scripts/verify_distribution_release_evidence.py",
    "evidence:clean-machine-verify": "python scripts/verify_clean_machine_evidence.py",
    "evidence:result-quality-verify": "python scripts/verify_result_quality_reviewed_evidence.py",
    "evidence:diagnostics-verify": "python scripts/verify_diagnostics_external_reviewed_evidence.py",
    "evidence:android-real-device-verify": "python scripts/verify_android_reviewed_evidence.py",
    "evidence:android-real-device-seal": "python scripts/seal_android_real_device_evidence.py",
    "evidence:support-privacy-verify": "python scripts/verify_support_privacy_rehearsal_evidence.py",
    "evidence:claims-launch-verify": "python scripts/verify_launch_claims_reviewed_evidence.py",
    "evidence:commercial-operations-verify": "python scripts/verify_commercial_operations_evidence.py",
    "evidence:commercial-operations-seal": "python scripts/seal_commercial_operations_evidence.py",
    "evidence:commercial-loop": "python scripts/verify_commercial_loop_evidence.py",
    "smoke:desktop-first-launch": "npm --prefix desktop run smoke:first-launch",
    "smoke:portable-first-screen": "powershell -ExecutionPolicy Bypass -File ./scripts/portable_first_screen_smoke.ps1",
    "delivery:plan": "python scripts/delivery_pipeline.py --plan-only",
    "delivery:run": "python scripts/delivery_pipeline.py --output build/delivery-verdict.json",
    "delivery:candidate": "python scripts/delivery_pipeline.py --candidate-build --output build/delivery-candidate-verdict.json",
    "delivery:rc": "python scripts/delivery_pipeline.py --strict --output build/delivery-verdict.json",
    "delivery:paid-launch": "python scripts/delivery_pipeline.py --paid-launch --output build/delivery-verdict.json"
  },
  "engines": {
    "node": ">=20"
  }
}
